---
import { getParsedFooters } from '~/utils/footer'

// ⚡ Bolt: Cache parsed footer HTML to avoid expensive sanitizeHtml calls on every page render.
// During SSG, SiteFooter renders on every single page. Since the footer configuration is static,
// we cache the sanitized result at the module level in `~/utils/footer.ts` to significantly reduce HTML parsing overhead.
const parsedFooters = getParsedFooters()
---

{parsedFooters && parsedFooters.length > 0 && parsedFooters.map((html) => <p set:html={html} />)}

<style>
  p {
    --at-apply: 'font-bold text-3';
  }
</style>
